{
  "name": "instagram-backend",
  "version": "0.1.0",
  "description": "Backend API for Instagram Clone iOS app - Hono + PostgreSQL + Better Auth",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:ws": "tsx watch src/websocket/index.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "lint": "eslint .",
    "test": "vitest",
    "test:contract": "tsx pact/verify-provider.ts",
    "test:contract:staging": "STAGING_API_URL=${STAGING_API_URL} tsx pact/verify-provider.ts",
    "test:contract:production": "PRODUCTION_API_URL=${PRODUCTION_API_URL} tsx pact/verify-provider.ts",
    "pact:publish": "tsx pact/publish-contracts.ts",
    "pact:can-i-deploy": "pact broker can-i-deploy --pacticipant=instagram-backend --version=${GITHUB_SHA:-local} --to-environment=production --broker-base-url=${PACT_BROKER_URL:-http://localhost:9292}",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio"
  },
  "keywords": [
    "instagram",
    "hono",
    "typescript",
    "postgresql",
    "better-auth"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@sentry/node": "^11.12.0",
    "@types/bcrypt": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.0.0",
    "hono": "^4.13.16",
    "hono-rate-limiter": "^0.5.4",
    "jose": "^5.9.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "^17.1.4",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "js-yaml": "^4.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
