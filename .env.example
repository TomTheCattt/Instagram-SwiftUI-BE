# Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# Works with any PostgreSQL: Docker local, Supabase, AWS RDS, Render, Railway, etc.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/instagram_clone

# Better Auth
BETTER_AUTH_SECRET=your-random-32-character-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,exp://192.168.1.100:8081

# Object Storage (S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_UPLOAD_BUCKET=uploads
S3_MEDIA_BUCKET=media
S3_THUMBNAIL_BUCKET=thumbnails
# CDN_BASE_URL=https://cdn.example.com

# Redis / Rate Limiting (Optional)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Email (Resend, SendGrid, etc. - Optional)
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# Logging
LOG_LEVEL=info

# Internal Cron Secret
INTERNAL_CRON_SECRET=dev-secret-change-in-production

# AI Gateway (Optional)
# AI_GATEWAY_TOKEN=
# AI_GATEWAY_BASE_URL=

# OAuth Providers (Optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
